# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
# In Docker: postgresql://blog_user:blog_password@db:5432/blog_db?schema=public
# In Local Dev: postgresql://postgres:postgres@localhost:5432/blog_db?schema=public
DATABASE_URL="postgresql://blog_user:blog_secure_password_replace_in_prod@localhost:5432/blog_db?schema=public"

# ==========================================
# Security & Authentication
# ==========================================
# Minimum 32-character random string for signing session cookies
# Generate via: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-very-secure-random-32-char-secret-key-12345"

# Initial Administrator Credentials (used by prisma/seed.ts)
ADMIN_EMAIL="admin@xyz.in"
ADMIN_PASSWORD="ReplaceWithAStrongAdminPassword123!"
ADMIN_NAME="Author"

# ==========================================
# Site Metadata & Configuration
# ==========================================
# In production, set to your custom domain: https://blog.xyz.in
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Alex Johnson"
NEXT_PUBLIC_SITE_TAGLINE="Writing on software systems, web engineering, and product craft."
NEXT_PUBLIC_SITE_BIO="Staff engineer and open-source enthusiast. Exploring distributed systems, clean interfaces, and resilient web architecture."
NEXT_PUBLIC_SITE_AVATAR=""
NEXT_PUBLIC_SITE_TWITTER="https://twitter.com"
NEXT_PUBLIC_SITE_GITHUB="https://github.com"
NEXT_PUBLIC_SITE_LINKEDIN="https://linkedin.com"

# ==========================================
# Storage Configuration
# ==========================================
# Set to 'local' for local file storage in public/uploads (default)
# Set to 's3' for production S3 / Cloudflare R2 / MinIO / DigitalOcean Spaces
STORAGE_PROVIDER="local"

# S3 Compatible Storage (required only if STORAGE_PROVIDER=s3)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
